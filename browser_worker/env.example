# Copy to .env.local or export in your shell before starting the worker / configuring AAVA.

# Required by AAVA tool (browser-automation-tool.py)
BROWSER_WORKER_URL=https://YOUR-TUNNEL-URL.trycloudflare.com
BROWSER_WORKER_TOKEN=change-me-to-a-long-random-secret

# Worker process settings
BROWSER_WORKER_TOKEN=change-me-to-a-long-random-secret
BROWSER_WORKER_SESSION_TTL=900
BROWSER_WORKER_HEADLESS=true
# Comma-separated allowlist (recommended for POC). Empty = allow all hosts.
BROWSER_WORKER_ALLOWED_HOSTS=vistapoc.nitor.in
